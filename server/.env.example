DATABASE_URL="mysql://root:password@localhost:3306/text_guard"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"

# 本地 AI 复核（可选，需先装 Ollama 并 pull gemma4:e2b）
# 启用后：每次检测的所有命中都会调 AI 复核（按 confidence 降序最多 LLM_JUDGE_MAX_PER_DETECTION 条）
LLM_JUDGE_ENABLED=false
OLLAMA_HOST=http://localhost:11434
LLM_JUDGE_MODEL=gemma4:e2b
LLM_JUDGE_MAX_PER_DETECTION=10
# CPU 推理首次冷启动可能要 10-30 秒；如果命中超时可以再调大
LLM_JUDGE_TIMEOUT_MS=30000
