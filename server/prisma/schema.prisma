datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique @db.VarChar(50)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  role         Role           @default(editor)
  createdAt    DateTime       @default(now()) @map("created_at")
  contents     Content[]
  reviews      Review[]
  logs         OperationLog[]

  @@map("users")
}

enum Role {
  admin
  editor
}

model Content {
  id              Int           @id @default(autoincrement())
  title           String        @db.VarChar(200)
  body            String        @db.Text
  filteredBody    String        @map("filtered_body") @db.Text
  category        String        @default("") @db.VarChar(50)
  status          ContentStatus @default(draft)
  riskLevel       RiskLevel?    @map("risk_level")
  riskScore       Int           @default(0) @map("risk_score")
  detectionResult Json?         @map("detection_result")
  isPinned        Boolean       @default(false) @map("is_pinned")
  authorId        Int           @map("author_id")
  author          User          @relation(fields: [authorId], references: [id])
  reviews         Review[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([riskLevel])
  @@index([authorId, status])
  @@index([category])
  @@index([isPinned, createdAt])
  @@map("contents")
}

enum ContentStatus {
  draft
  pending
  published
  rejected
}

enum RiskLevel {
  low
  medium
  high
}

enum SensitiveMatchType {
  literal
  regex
  credential
}

enum SensitiveContextScope {
  strict
  lenient
  global
}

model SensitiveWord {
  id              Int                   @id @default(autoincrement())
  word            String                @unique @db.VarChar(200)
  matchType       SensitiveMatchType    @default(literal) @map("match_type")
  pattern         String?               @db.VarChar(500)
  riskLevel       RiskLevel             @map("risk_level")
  replacement     String                @default("***") @db.VarChar(100)
  category        String                @default("") @db.VarChar(50)
  enabled         Boolean               @default(true)
  version         Int                   @default(1)
  baseConfidence  Float                 @default(1.0) @map("base_confidence")
  variantMatch    Boolean               @default(true) @map("variant_match")
  contextScope    SensitiveContextScope @default(strict) @map("context_scope")
  positiveSamples String?               @db.Text @map("positive_samples")
  negativeSamples String?               @db.Text @map("negative_samples")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  events          DetectionEvent[]

  @@index([enabled])
  @@index([enabled, riskLevel])
  @@index([enabled, matchType])
  @@map("sensitive_words")
}

model DetectionEvent {
  id           Int            @id @default(autoincrement())
  contentId    Int?           @map("content_id")
  wordId       Int?           @map("word_id")
  word         SensitiveWord? @relation(fields: [wordId], references: [id], onDelete: SetNull)
  wordVersion  Int?           @map("word_version")
  ruleSource   String         @map("rule_source") @db.VarChar(40)
  hitText      String         @map("hit_text") @db.VarChar(500)
  start        Int
  end          Int
  riskLevel    RiskLevel      @map("risk_level")
  confidence   Float
  judgeVerdict String?        @map("judge_verdict") @db.VarChar(40)
  reason       String?        @db.VarChar(200)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([contentId])
  @@index([wordId, createdAt])
  @@index([createdAt])
  @@map("detection_events")
}

model Review {
  id         Int          @id @default(autoincrement())
  contentId  Int          @map("content_id")
  content    Content      @relation(fields: [contentId], references: [id])
  reviewerId Int          @map("reviewer_id")
  reviewer   User         @relation(fields: [reviewerId], references: [id])
  action     ReviewAction
  comment    String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([contentId])
  @@index([reviewerId, createdAt])
  @@index([action, createdAt])
  @@map("reviews")
}

enum ReviewAction {
  approve
  reject
}

model OperationLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(50)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   Int?     @map("target_id")
  detail     String?  @db.Text
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("operation_logs")
}

enum PermType {
  menu
  action
  data
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(80)
  module      String           @db.VarChar(40)
  type        PermType
  description String?          @db.VarChar(200)
  createdAt   DateTime         @default(now()) @map("created_at")
  rolePerms   RolePermission[]
  menus       Menu[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  role         Role
  permissionId Int        @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Menu {
  id           Int         @id @default(autoincrement())
  parentId     Int?        @map("parent_id")
  parent       Menu?       @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Menu[]      @relation("MenuTree")
  name         String      @db.VarChar(40)
  path         String      @db.VarChar(120)
  icon         String?     @db.VarChar(40)
  permissionId Int?        @map("permission_id")
  permission   Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  sort         Int         @default(0)
  visible      Boolean     @default(true)

  @@index([parentId])
  @@map("menus")
}
